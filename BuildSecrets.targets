<Project>

  <!--
    构建期凭据注入。

    为什么不是直接把 key 写进源码：本仓库是**公开**的，写进源码等于公开发布，
    谁拿到代码都能用你的配额。这里让仓库只保留「机制」，值来自：
      1. secrets.props（本地，已 gitignore）
      2. 环境变量 TVDB_API_KEY / TMDB_API_KEY（CI 用 GitHub Actions secrets 注入）
      3. 都没有 → 留空，相关 provider 自动禁用（不报错、不静默失败）

    生成物落在 obj/ 下，同样不进仓库。
  -->

  <!-- 本地凭据文件（可选存在） -->
  <Import Project="$(MSBuildThisFileDirectory)secrets.props" Condition="Exists('$(MSBuildThisFileDirectory)secrets.props')" />

  <PropertyGroup>
    <!-- 环境变量兜底：MSBuild 会把同名环境变量当成属性读出来 -->
    <TvdbApiKey Condition="'$(TvdbApiKey)' == ''">$(TVDB_API_KEY)</TvdbApiKey>
    <TmdbApiKey Condition="'$(TmdbApiKey)' == ''">$(TMDB_API_KEY)</TmdbApiKey>

    <!-- 只注入到真正用到它们的程序集 -->
    <_OpenMediaSecretsProject Condition="'$(MSBuildProjectName)' == 'MediaBrowser.Providers'">true</_OpenMediaSecretsProject>

    <_OpenMediaSecretsContent>// &lt;auto-generated&gt; 构建期注入，见 build/BuildSecrets.targets。不要手改，不要提交。</_OpenMediaSecretsContent>
  </PropertyGroup>

  <ItemGroup Condition="'$(_OpenMediaSecretsProject)' == 'true'">
    <_BuildSecretLine Include="// &lt;auto-generated/&gt; build/BuildSecrets.targets — 构建期注入，不要手改、不要提交" />
    <_BuildSecretLine Include="namespace MediaBrowser.Providers%3B" />
    <_BuildSecretLine Include="internal static class BuildSecrets" />
    <_BuildSecretLine Include="{" />
    <_BuildSecretLine Include="    internal const string TvdbApiKey = &quot;$(TvdbApiKey)&quot;%3B" />
    <_BuildSecretLine Include="    internal const string TmdbApiKey = &quot;$(TmdbApiKey)&quot;%3B" />
    <_BuildSecretLine Include="}" />
  </ItemGroup>

  <Target Name="EmitBuildSecrets"
          BeforeTargets="CoreCompile"
          Condition="'$(_OpenMediaSecretsProject)' == 'true'"
          Inputs="$(MSBuildThisFileFullPath)"
          Outputs="$(IntermediateOutputPath)BuildSecrets.g.cs">
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildSecrets.g.cs"
                      Lines="@(_BuildSecretLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildSecrets.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)BuildSecrets.g.cs" />
    </ItemGroup>
  </Target>

</Project>
