<!--
  本地凭据文件 —— 复制成 secrets.props 后填写。

  secrets.props 已被 .gitignore 忽略，**永远不会进仓库**。
  也可以在 CI / 容器构建时改用环境变量（同名大写，下划线分隔）：
      TVDB_API_KEY / TMDB_API_KEY / FANART_API_KEY
  优先级：secrets.props > 环境变量 > 源码里的历史默认值。
-->
<Project>
  <PropertyGroup>
    <TvdbApiKey>在这里填 your-tvdb-key</TvdbApiKey>
    <TmdbApiKey>在这里填 your-tmdb-key</TmdbApiKey>
    <FanartApiKey>在这里填 your-fanart-key</FanartApiKey>
  </PropertyGroup>
</Project>
