<Project Sdk="Microsoft.NET.Sdk">

  <!--
    批量写并发压测（对应评审 P1-5）。
    独立可执行工程：不依赖服务端进程，直连 docker compose 的 PostgreSQL。

    运行：
      docker compose up -d postgres
      dotnet run -c Release -p:tests/perf/PgBatchWriteStress  (参数：clients / rounds)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>PgBatchWriteStress</AssemblyName>
    <RootNamespace>PgBatchWriteStress</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- 压测工程不参与线程分析器门禁 -->
    <EnableVSTHRDAnalyzers>false</EnableVSTHRDAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.2" />
  </ItemGroup>

</Project>
