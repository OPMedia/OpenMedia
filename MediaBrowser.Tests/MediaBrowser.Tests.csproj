<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>MediaBrowser.Tests</AssemblyName>
    <RootNamespace>MediaBrowser.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SharedVersion.cs" Link="Properties\SharedVersion.cs" />
  </ItemGroup>

  <!-- 测试资源：字幕样例随输出目录复制，避免依赖运行目录（跨平台） -->
  <ItemGroup>
    <None Include="MediaEncoding\Subtitles\TestSubtitles\**\*"
          Link="MediaEncoding\Subtitles\TestSubtitles\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\MediaBrowser.Model\MediaBrowser.Model.csproj" />
    <ProjectReference Include="..\src\MediaBrowser.Common\MediaBrowser.Common.csproj" />
    <ProjectReference Include="..\src\MediaBrowser.Controller\MediaBrowser.Controller.csproj" />
    <ProjectReference Include="..\src\Emby.Server.MediaEncoding\Emby.Server.MediaEncoding.csproj" />
    <ProjectReference Include="..\Emby.Server.Implementations\Emby.Server.Implementations.csproj" />
    <ProjectReference Include="..\MediaBrowser.Providers\MediaBrowser.Providers.csproj" />
    <ProjectReference Include="..\MediaBrowser.XbmcMetadata\MediaBrowser.XbmcMetadata.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
  </ItemGroup>

</Project>
