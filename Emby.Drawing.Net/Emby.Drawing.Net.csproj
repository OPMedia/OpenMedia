<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Emby.Drawing.Net</AssemblyName>
    <RootNamespace>Emby.Drawing.Net</RootNamespace>
    <!-- net10.0 上 System.Drawing.Common 仅 Windows 可用（兜底编码器，CA1416 平台警告预期存在） -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SharedVersion.cs" Link="Properties\SharedVersion.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- net10.0 上 System.Drawing.Common 仅 Windows 可用（兜底编码器，可接受） -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="empty.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\MediaBrowser.Model\MediaBrowser.Model.csproj" />
    <ProjectReference Include="..\src\MediaBrowser.Common\MediaBrowser.Common.csproj" />
    <ProjectReference Include="..\src\MediaBrowser.Controller\MediaBrowser.Controller.csproj" />
  </ItemGroup>

</Project>
