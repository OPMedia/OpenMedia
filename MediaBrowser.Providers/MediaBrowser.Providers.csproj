<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>MediaBrowser.Providers</AssemblyName>
    <RootNamespace>MediaBrowser.Providers</RootNamespace>
    <!-- 线程分析器门禁：本工程内阻塞/死锁/崩溃类规则即为 error。 -->
    <WarningsAsErrors>$(WarningsAsErrors);VSTHRD002;VSTHRD003;VSTHRD100;VSTHRD103;VSTHRD110</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SharedVersion.cs" Link="Properties\SharedVersion.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\MediaBrowser.Model\MediaBrowser.Model.csproj" />
    <ProjectReference Include="..\src\MediaBrowser.Common\MediaBrowser.Common.csproj" />
    <ProjectReference Include="..\src\MediaBrowser.Controller\MediaBrowser.Controller.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PlaylistsNET" Version="1.0.2" />
  </ItemGroup>

</Project>
