<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>MediaBrowser.WebDashboard</AssemblyName>
    <RootNamespace>MediaBrowser.WebDashboard</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SharedVersion.cs" Link="Properties\SharedVersion.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\MediaBrowser.Model\MediaBrowser.Model.csproj" />
    <ProjectReference Include="..\src\MediaBrowser.Common\MediaBrowser.Common.csproj" />
    <ProjectReference Include="..\src\MediaBrowser.Controller\MediaBrowser.Controller.csproj" />
  </ItemGroup>

  <!-- dashboard-ui 由文件系统服务（ResourceFileManager），复制到输出目录；
       旧 csproj 的 EmbeddedResource(resources\) 无代码消费，已移除 -->
  <ItemGroup>
    <Content Include="dashboard-ui\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
